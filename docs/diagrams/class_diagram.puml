@startuml
' Ρυθμίσεις για να μην κρασάρει και να είναι καθαρό
hide members
hide circle
skinparam packageStyle rectangle

' --- 1. DATA MODEL ---
package "Data Model" {
    class BudgetChangesEntry
    class Year
    
    abstract class BudgetChange
    class AbsoluteAmountChange
    class PercentageChange
    class TransferChange
    
    BudgetChange <|-- AbsoluteAmountChange
    BudgetChange <|-- PercentageChange
    BudgetChange <|-- TransferChange
    BudgetChange ..> BudgetChangesEntry
}

' --- 2. CORE LOGIC & HELPERS ---
package "Core Logic" {
    class BudgetManager
    class ChangeManager
    class ChangeValidator
    class BudgetAnalyzer
    class RevenueDataManager
    class ExpenseManager
    class ExpenseDisplay
    class ValidationResult
    class AppException
}

' --- 3. DATA ACCESS ---
package "Data Access" {
    class BudgetRepository
    class BudgetIOHandler
    class CsvToArray
    class BudgetFileResolver
}

' --- 4. VISUALIZATION ---
package "Charts System" {
    class BudgetChartJFree
}

' --- 5. USER INTERFACE ---
package "UI Views (Frontend)" {
    class MainFrame
    class MenuPanel
    class App
    class BudgetMainTest
    
    package "Input/Action Panels" {
        class InsertChangePanel
        class AbsoluteChangePanel
        class PercentageChangePanel
        class TransferChangePanel
        class ConfirmButtonListener
    }
    
    package "Selection/Menu Panels" {
        class ChangeMenuPanel
        class YearSelectionPanel
        class MinistriesSelectionPanel
        class ChartsMenuPanel
        class BudgetPanel
    }

    package "Data View Panels" {
        class RevenuePanel
        class Revenue2Panel
        class Revenue3Panel
        class Revenue4Panel
        class ExpensePanel
        class ExpenseByCategoryPanel
        class ExpenseByCategory2Panel
        class AgencyDetailsPanel
        class ExpenseByAgencySummaryPanel
        class ViewEntriesPanel
        class ViewAuditLogPanel
    }
    
    package "Chart Panels" {
        class RevenueChartPanel
        class ExpenseChartPanel
    }
}

' --- ΒΑΣΙΚΕΣ ΣΥΝΔΕΣΕΙΣ ---

' Το MainFrame συνδέει τα πάντα
MainFrame o-- MenuPanel
MainFrame o-- InsertChangePanel
MainFrame o-- RevenuePanel
MainFrame o-- ExpensePanel
MainFrame o-- ChangeMenuPanel

' Σύνδεση Logic
BudgetManager *-- BudgetRepository
ChangeManager *-- BudgetRepository
ChangeValidator ..> BudgetRepository
BudgetManager o-- ChangeManager

' Σύνδεση UI -> Logic
InsertChangePanel ..> BudgetManager
ViewEntriesPanel ..> BudgetManager
RevenueChartPanel ..> BudgetChartJFree

@enduml